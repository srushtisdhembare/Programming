# Application to accept a list of integers and use Pool.map() to calculate sum of squares from 1 to N for every element in the list

import multiprocessing

def SumSquare(No):

    Sum = 0

    for i in range(1,No + 1):
        Sum = Sum + (i**2) 

    return Sum

def main():
    print("Enter number of elements in list : ")
    number = int(input())

    Elements = list()

    for i in range(1,number+1):
        num = int(input())
        Elements.append(num)

    pobj = multiprocessing.Pool()

    result = pobj.map(SumSquare,Elements)

    pobj.close()
    pobj.join()

    print("Result is : ",result)

if __name__ == "__main__":
    main()