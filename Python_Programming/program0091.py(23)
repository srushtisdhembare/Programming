# For every given number in the list, calculate no of all even nos from 1 to N for all elements of list using Pool

import os
import multiprocessing

def CountEven(No):
    Ans = 0

    i = 0
    for i in range(1,No+1):
        if i % 2 == 0:
            Ans = Ans + 1
            
    print("Ans : ",Ans)
    print("Process Id :",os.getpid())
    return Ans

def main():
    print("Enter number of elements in list : ")
    number = int(input())

    Elements = list()

    for i in range(1,number+1):
        num = int(input())
        Elements.append(num)

    pobj = multiprocessing.Pool()

    result = pobj.map(CountEven,Elements)

    pobj.close()
    pobj.join()

    print("Result is : ",result)

if __name__ == "__main__":
    main()