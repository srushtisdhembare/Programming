# For every given number in the list, count how many prime nos exist bw 1 and N using multiprocessing Pool

import os
import multiprocessing

def CountPrime(No):
    Count = 0

    i = 0
    for i in range(2,No):
        if i % 2 != 0:
            print(i,end="\t")
            Count = Count + 1
            
    print("Count : ",Count)
    return Count

def main():
    print("Enter number of elements in list : ")
    number = int(input())

    Elements = list()

    for i in range(1,number+1):
        num = int(input())
        Elements.append(num)

    pobj = multiprocessing.Pool()

    result = pobj.map(CountPrime,Elements)

    pobj.close()
    pobj.join()

    print("Result is : ",result)

if __name__ == "__main__":
    main()