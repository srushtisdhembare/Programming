# For every given number in the list, calculate 1^5 + 2^5 + 3^5...N^5 for all elements of list

import os
import multiprocessing

def PowerAdd(No):
    Ans = 0

    i = 0
    for i in range(1,No+1):
        Ans = Ans + i**5
            
    print("Ans : ",Ans)
    return Ans

def main():
    print("Enter number of elements in list : ")
    number = int(input())

    Elements = list()

    for i in range(1,number+1):
        num = int(input())
        Elements.append(num)

    pobj = multiprocessing.Pool()

    result = pobj.map(PowerAdd,Elements)

    pobj.close()
    pobj.join()

    print("Result is : ",result)

if __name__ == "__main__":
    main()